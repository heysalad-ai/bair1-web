      "AttributeType": "S"
    },
    {
      "AttributeName": "ownerId",
      "AttributeType": "S"
    },
    {
      "AttributeName": "orgId",
      "AttributeType": "S"
    }
  ],
  "GlobalSecondaryIndexes": [
