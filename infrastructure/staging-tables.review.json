{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "REVIEW ONLY: seven isolated Bair1 staging tables. No production names or provisioning operations are used by the app.",
  "Parameters": {
    "TablePrefix": {
      "Type": "String",
      "Default": "bair1-staging-customer-isolation-",
      "AllowedPattern": "^bair1-staging-[a-z0-9-]+-$"
    }
  },
  "Resources": {
    "Readings": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}readings"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "deviceId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "timestamp",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "deviceId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "timestamp",
            "AttributeType": "S"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        }
      }
    },
    "ReadingEvents": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}reading-events"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "deviceId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "eventId",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "deviceId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "eventId",
            "AttributeType": "S"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        }
      }
    },
    "Commands": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}commands"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "deviceId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "commandId",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "commandId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "deviceId",
            "AttributeType": "S"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        }
      }
    },
    "Devices": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}devices"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "deviceId",
            "KeyType": "HASH"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "deviceId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "orgId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "ownerId",
            "AttributeType": "S"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "ownerId-deviceId-index",
            "KeySchema": [
              {
                "AttributeName": "ownerId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "deviceId",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          },
          {
            "IndexName": "orgId-deviceId-index",
            "KeySchema": [
              {
                "AttributeName": "orgId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "deviceId",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ]
      }
    },
    "ApiKeys": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}api-keys"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "createdAt",
            "AttributeType": "S"
          },
          {
            "AttributeName": "id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "keyHash",
            "AttributeType": "S"
          },
          {
            "AttributeName": "orgId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "keyHash-index",
            "KeySchema": [
              {
                "AttributeName": "keyHash",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "userId-createdAt-index",
            "KeySchema": [
              {
                "AttributeName": "userId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "createdAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "orgId-createdAt-index",
            "KeySchema": [
              {
                "AttributeName": "orgId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "createdAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ]
      }
    },
    "Users": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}users"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "userId",
            "KeyType": "HASH"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          }
        ]
      }
    },
    "Access": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TablePrefix}access"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "KeySchema": [
          {
            "AttributeName": "scope",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "entry",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "entry",
            "AttributeType": "S"
          },
          {
            "AttributeName": "scope",
            "AttributeType": "S"
          },
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "workspaceId",
            "AttributeType": "S"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "userId-workspaceId-index",
            "KeySchema": [
              {
                "AttributeName": "userId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "workspaceId",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        }
      }
    }
  }
}